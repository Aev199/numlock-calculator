{
  "name": "numlock-calculator",
  "version": "1.0.0",
  "description": "Современный клон NumLock Calculator — инженерный калькулятор, вызываемый по клавише NumLock",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.numlock.calc",
    "productName": "NumLock Calc",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "NumLock Calc"
    },
    "portable": {
      "artifactName": "NumLockCalc_Portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.0"
  }
}
